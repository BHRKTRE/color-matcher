// The site as a Worker with static assets, deployed by hand (`npm run deploy`).
// It ran on Cloudflare Pages until 2026-10-29; Cloudflare starts new projects
// on Workers and puts new features there.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "color-matcher",
	"compatibility_date": "2024-09-25",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "color-matcher.app", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
